# Backend (REST API) ga ulanish uchun shu faylni .env.local ga nusxalang.
# VITE_USE_API=false  -> ma'lumotlar brauzer localStorage'da (demo rejim)
# VITE_USE_API=true   -> ma'lumotlar haqiqiy backend'dan olinadi
VITE_USE_API=false
# Backend ILDIZ manzili (oxirida / va /api qo'ymang — httpDriver.js o'zi /api/v1/... qo'shadi)
VITE_API_URL=http://127.0.0.1:8000

